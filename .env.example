# Copiar a .env (no se commitea) y completar.
# EPO OPS: registro gratuito en https://developers.epo.org/ (OAuth2 client credentials)
EPO_OPS_KEY=
EPO_OPS_SECRET=
# OpenAlex: API key gratuita (https://openalex.org/)
OPENALEX_API_KEY=
# NO definir ANTHROPIC_API_KEY: el LLM usa el login Max de Claude Code (`claude -p`).
